{
  "name": "record-a-skill",
  "version": "1.0.0",
  "private": true,
  "description": "Turn a screen demonstration into a reusable agent skill",
  "author": "Record a Skill",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node tests/desktop.mjs",
    "package": "npm run build && electron-builder --win nsis",
    "package:dir": "npm run build && electron-builder --win dir",
    "test:settings": "node tests/settings-desktop.mjs",
    "test:tools": "node tests/tool-settings-desktop.mjs",
    "test:layout": "node tests/ui-layout-desktop.mjs",
    "test:import": "node tests/import-desktop.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "concurrently": "^9.2.1",
    "electron": "44.5.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.3",
    "vite": "8.3.1",
    "wait-on": "^8.0.5"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "com.recordaskill.desktop",
    "productName": "Record a Skill",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
